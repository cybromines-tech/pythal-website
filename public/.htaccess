Options -Indexes
DirectoryIndex index.html

# Clean URLs: /our-story serves our-story.html (Astro builds with format: 'file').
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Send /our-story.html to the clean URL so each page has one address.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

AddType font/woff .woff
AddType font/woff2 .woff2
AddType image/webp .webp
AddType video/mp4 .mp4

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # HTML always revalidates so new deploys show up immediately.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Astro fingerprints everything under /_astro, so it can be cached forever.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(woff2?|webp|png|jpg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
