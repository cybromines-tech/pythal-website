---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/marcellus/400.css';
import '../styles/global.scss';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pythal — The First That Lasts',
  description = 'Pythal — The First That Lasts. Luxury newborn gifting, editions and keepsakes.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/hero-art.webp', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f9f6f1" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pythal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Luxury newborn gifting, editions and keepsakes." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/BrilliantSignature-Regular.woff" as="font" type="font/woff" crossorigin />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      imagesrcset="/images/hero-art-1400.webp 1400w, /images/hero-art.webp 3456w"
      imagesizes="(max-width: 767.98px) 420px, 100vw"
      fetchpriority="high"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Pythal',
        url: 'https://pythal.com/',
        email: 'customersupport@pythal.com',
        telephone: '+971581032642',
        sameAs: ['https://www.instagram.com/pythal.ae/', 'https://www.pinterest.com/pythalae/'],
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
