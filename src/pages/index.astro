---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Bundles from '../components/Bundles.astro';
import Giving from '../components/Giving.astro';
import Fashion from '../components/Fashion.astro';
import Safety from '../components/Safety.astro';
import StoryBanner from '../components/StoryBanner.astro';
import Benefits from '../components/Benefits.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import RegionDialog from '../components/RegionDialog.astro';
---

<Layout>
  <div class="page">
    <SiteHeader />
    <main id="main">
      <Hero />
      <Bundles />
      <Giving />
      <Fashion />
      <Safety />
      <StoryBanner />
      <Benefits />
    </main>
    <SiteFooter />
    <NewsletterPopup />
    <RegionDialog />
  </div>
</Layout>

<script>
  // Play background films only while they are on screen (saves battery and data).
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')];
  const visible = new Set<HTMLVideoElement>();
  const play = (video: HTMLVideoElement) => {
    video.muted = true;
    video.play().catch(() => {});
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) {
          visible.add(video);
          play(video);
        } else {
          visible.delete(video);
          video.pause();
        }
      }
    },
    { rootMargin: '100px 0px' },
  );

  // Start downloading well before a film scrolls into view so it is ready to play.
  const warm = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (!isIntersecting || video.preload === 'auto') continue;
        video.preload = 'auto';
        video.load();
        warm.unobserve(video);
      }
    },
    { rootMargin: '1500px 0px' },
  );

  videos.forEach((video) => {
    video.muted = true;
    video.addEventListener('canplay', () => visible.has(video) && video.paused && play(video));
    observer.observe(video);
    warm.observe(video);
  });

  // iOS Low Power Mode blocks autoplay until the first interaction; start anything on screen then.
  const resume = () => visible.forEach((video) => video.paused && play(video));
  ['touchstart', 'pointerdown', 'scroll'].forEach((type) =>
    addEventListener(type, resume, { passive: true, once: true }),
  );
  document.addEventListener('visibilitychange', () => !document.hidden && resume());
</script>

<style lang="scss">
  // Every band is positioned on the Figma frame, so the page is exactly the frame's height.
  .page {
    position: relative;
    height: u(6824 + $bundles-extra);
    overflow-x: clip;

    @include phone {
      height: u(2876 + $bundles-extra-phone - $phone-status-bar);
    }
  }
</style>
