---
import Heart from './Heart.astro';
---

<section class="giving" id="giving" aria-labelledby="giving-title">
  <div class="frame">
    <span class="rule rule-l" aria-hidden="true"></span>
    <h2 id="giving-title">The Art Of Giving</h2>
    <span class="rule rule-r" aria-hidden="true"></span>

    <p class="verse verse-1">
      For the little soul I came to love,<br />
      a little piece of love from me.<br />
      For tiny hands to hold today,<br />
      and little memories yet to be.
    </p>
    <Heart class="heart" />
    <p class="verse verse-2">
      A gift for now,<br />
      a love to stay,<br />
      a memory to find<br />
      along the way.
    </p>
    <p class="signoff">PYTHAL<small>MADE FOR THE LOVE WE LEAVE BEHIND.</small></p>

    <img
      class="art"
      src="/images/giving-art.webp"
      alt="Two hands offering the Pythal house gift box, tied with a ribbon that curls into a heart"
      width="1493"
      height="575"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style lang="scss">
  $top: 2370;
  $p-top: 965;

  .giving {
    @include band($top + $bundles-extra, 1335, $p-top + $bundles-extra-phone, 505);
    z-index: 1;
  }

  h2 {
    @include center-on(873.5, 2435 - $top - 75, 700);
    font-family: var(--font-script);
    font-weight: 400;
    @include text(69.5, 150);
    white-space: nowrap;

    @include phone {
      @include center-on(207.8, 995 - $p-top - 30, 402);
      @include text(22.4, 60);
    }
  }

  .rule {
    height: 1px;
    background: #6b5242;
  }

  .rule-l {
    @include at(497, 2435 - $top, 120, 1);

    @include phone {
      @include at(77.7, 995 - $p-top, 47, 1);
    }
  }

  .rule-r {
    @include at(1152, 2435 - $top, 120, 1);

    @include phone {
      @include at(292, 995 - $p-top, 48, 1);
    }
  }

  // The old pythal.com set this poem in Avenir Next at 16px.
  .verse,
  .signoff {
    color: #2d2926;
    font-family: 'Avenir Next', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 400;
  }

  .verse {
    @include text(21, 30.7);

    @include phone {
      @include text(14, 20.3);
    }
  }

  .verse-1 {
    @include center-on(855, 2531 - 11.7 - $top, 900);

    @include phone {
      @include center-on(210.5, 1052.6 - 10.15 - $p-top, 402);
    }
  }

  .verse-2 {
    @include center-on(855, 2712 - 11.7 - $top, 900);

    @include phone {
      @include center-on(210.5, 1173.5 - 10.15 - $p-top, 402);
    }
  }

  :global(.heart) {
    @include at(855 - 17, 2658 - 17 - $top, 34, 34);
    color: var(--heart);

    @include phone {
      @include at(210.5 - 11, 1143.5 - 11 - $p-top, 22, 22);
    }
  }

  .signoff {
    @include center-on(855.5, 2850 - 10.15 - $top, 1000);
    @include text(17.5, 25.4);
    letter-spacing: 0.02em;

    small {
      display: block;
      margin-top: u(2.5);
      @include text(13.5, 19.5);
      letter-spacing: 0.06em;

      @include phone {
        margin-top: u(1.5);
        @include text(10, 14);
      }
    }

    @include phone {
      @include center-on(211, 1270.4 - 8.5 - $p-top, 402);
      @include text(12, 17);
    }
  }

  .art {
    @include at(0, 3133 - $top, 1493, 575);

    @include phone {
      @include at(0, 1305 - $p-top, 402, 154.8);
    }
  }
</style>
