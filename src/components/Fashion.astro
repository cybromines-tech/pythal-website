---
import LoopVideo from './LoopVideo.astro';
import Arrow from './Arrow.astro';

// Films in the carousel; add more names here (public/video/<name>.mp4, <name>-m.mp4
// and public/images/poster-<name>.webp). The one at `start` sits in the centre first.
const videos = ['v4-web', 'v5-web', 'v6-web', 'v12-web', 'v14-web', 'v21-web', 'v27-web', 'v34-web'];
const start = 1;

// Slot for a film `d` steps from the focused one; only three are on show.
const slots: Record<string, string> = { '-1': 'side-l', '0': 'center', '1': 'side-r' };
const offset = (i: number) => {
  const n = videos.length;
  let d = (((i - start) % n) + n) % n;
  if (d > n / 2) d -= n;
  return d;
};
---

<section class="fashion" id="fashion" aria-labelledby="fashion-title">
  <div class="frame">
    <span class="rule rule-l" aria-hidden="true"></span>
    <h2 id="fashion-title">FASHION AND STYLE</h2>
    <span class="rule rule-r" aria-hidden="true"></span>

    {
      videos.map((name, i) => (
        <div
          class:list={['look', 'slide', slots[offset(i)] ?? 'off']}
          data-slide={i}
          style={`background-image:url(/images/poster-${name}.webp)`}
        >
          <LoopVideo name={name} label="Pythal fashion film" managed />
        </div>
      ))
    }

    <button type="button" class="nav nav-prev" aria-label="Previous film" data-dir="-1"><Arrow length={40} /></button>
    <button type="button" class="nav nav-next" aria-label="Next film" data-dir="1"><Arrow length={40} /></button>
  </div>
</section>

<script>
  // Rotate the films through the slots: the centre film holds focus for ten seconds, then
  // hands it to the next one, looping forever; the arrows (and tapping a side film) move
  // focus by hand and start the ten seconds again.
  const SLOTS: Record<number, string> = { [-1]: 'side-l', 0: 'center', 1: 'side-r' };
  const ALL = ['side-l', 'center', 'side-r', 'off'];
  const FOCUS_MS = 10000;
  // A film within this many steps of the focused one downloads ahead of its turn, so on a slow
  // line it is already buffered when the rotation reaches it.
  const WARM = 2;
  // readyState >= HAVE_FUTURE_DATA: enough buffered to seek and play without blanking.
  const READY = 3;

  for (const root of document.querySelectorAll<HTMLElement>('.fashion')) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const n = slides.length;
    if (n < 2) continue;
    let active = slides.findIndex((s) => s.classList.contains('center'));
    const offsetOf = (i: number) => {
      let d = (((i - active) % n) + n) % n;
      if (d > n / 2) d -= n;
      return d;
    };

    // Every film loops, so a clip shorter than ten seconds keeps playing until its turn is up.
    // Hovering holds the rotation so the film under the pointer plays right through.
    let timer: ReturnType<typeof setTimeout> | undefined;
    let held = false;
    const arm = () => {
      clearTimeout(timer);
      if (root.dataset.visible && !held) timer = setTimeout(advance, FOCUS_MS);
    };

    const render = (prev: number[]) => {
      slides.forEach((slide, i) => {
        const d = offsetOf(i);
        const video = slide.querySelector('video')!;
        // A film wrapping round from one end to the other jumps instead of sliding across.
        slide.classList.toggle('jump', Math.abs(d - prev[i]) > 1);
        slide.classList.remove(...ALL);
        slide.classList.add(SLOTS[d] ?? 'off');
        video.loop = true;
        // The films on show and the next couple in line fetch themselves; the rest stay idle.
        const warm = Math.abs(d) <= WARM;
        if (warm && video.preload !== 'auto') {
          video.preload = 'auto';
          video.load();
        }
        // The focused film starts from the top so each turn opens on the same frame — but only
        // once it can play, since seeking a half-loaded film blanks it.
        if ((d === 0 || video.ended) && video.readyState >= READY) video.currentTime = 0;
        if (warm && video.paused && root.dataset.visible) video.play().catch(() => {});
        else if (!warm && !video.paused) video.pause();
      });
    };

    // Hand focus on, unless the film taking over has nothing buffered yet: then wait for it
    // rather than slide a black oval into the centre.
    const advance = () => {
      const next = slides[(active + 1) % n];
      const video = next.querySelector('video')!;
      if (video.readyState >= READY) return go(1);
      video.addEventListener('canplay', () => offsetOf(slides.indexOf(next)) === 1 && go(1), {
        once: true,
      });
      video.preload = 'auto';
    };

    const go = (step: number) => {
      const prev = slides.map((_, i) => offsetOf(i));
      active = (active + step + n) % n;
      render(prev);
      arm();
    };

    slides.forEach((slide, i) => {
      const video = slide.querySelector('video')!;
      video.loop = true;
      // The `poster` attribute only covers the very first play, so the still sits behind the
      // film as a background and the film fades over it once it actually has pictures.
      const shown = (on: boolean) => slide.classList.toggle('playing', on);
      video.addEventListener('playing', () => shown(true));
      for (const e of ['waiting', 'stalled', 'emptied', 'seeking']) {
        video.addEventListener(e, () => shown(false));
      }
      slide.addEventListener('click', () => {
        const d = offsetOf(i);
        if (d) go(d);
      });
      // Pointing at a film brings it to the centre and keeps it there until the pointer leaves.
      slide.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        held = true;
        const d = offsetOf(i);
        if (d) go(d);
        else arm();
      });
      slide.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        held = false;
        arm();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('.nav').forEach((btn) =>
      btn.addEventListener('click', () => go(Number(btn.dataset.dir))),
    );

    // Left/right arrow keys move focus while the section is on screen.
    document.addEventListener('keydown', (e) => {
      if (!root.dataset.visible || e.altKey || e.ctrlKey || e.metaKey) return;
      const t = e.target;
      if (t instanceof Element && t.closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });

    // The ten seconds — and the films themselves — only run while the section is on screen.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) root.dataset.visible = '1';
        else delete root.dataset.visible;
        slides.forEach((slide, i) => {
          const video = slide.querySelector('video')!;
          if (Math.abs(offsetOf(i)) > WARM) return;
          if (!e.isIntersecting) video.pause();
          else if (video.paused) {
            video.muted = true;
            if (video.preload !== 'auto') {
              video.preload = 'auto';
              video.load();
            }
            video.play().catch(() => {});
          }
        });
        arm();
      },
      { rootMargin: '300px 0px' },
    ).observe(root);

    // A film that only finishes buffering later still starts on its own.
    slides.forEach((slide, i) => {
      const video = slide.querySelector('video')!;
      video.addEventListener('canplay', () => {
        if (root.dataset.visible && video.paused && Math.abs(offsetOf(i)) <= WARM) {
          video.play().catch(() => {});
        }
      });
    });
  }
</script>

<style lang="scss">
  $top: 3705;
  $p-top: 1470;

  .fashion {
    @include band($top + $bundles-extra, 1120, $p-top + $bundles-extra-phone, 320);
  }

  h2 {
    @include center-on(869, 3740 - 20 - $top, 700);
    font-weight: 500;
    @include text(40, 40);

    @include phone {
      @include center-on(201.5, 1490.7 - 10 - $p-top, 402);
      @include text(20, 20);
    }
  }

  .rule {
    height: 1px;
    background: var(--rule);
  }

  .rule-l {
    @include at(247, 3740 - $top, 390, 1);

    @include phone {
      @include at(51, 1490.7 - $p-top, 44, 1);
    }
  }

  .rule-r {
    @include at(1091, 3740 - $top, 373, 1);

    @include phone {
      @include at(308, 1490.7 - $p-top, 46, 1);
    }
  }

  .look {
    overflow: hidden;
    border-radius: 999px;
    background: var(--placeholder) center / cover no-repeat;

    :global(video) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    // Until the film has frames to show, the poster still behind it stands in for it.
    &.playing :global(video) {
      opacity: 1;
    }
  }

  .slide {
    z-index: 1;
    cursor: pointer;
    transition:
      left 0.7s ease,
      top 0.7s ease,
      width 0.7s ease,
      height 0.7s ease,
      opacity 0.7s ease;

    &.center {
      cursor: default;
    }

    &.jump {
      transition: none;
    }

    &.off {
      opacity: 0;
      pointer-events: none;
      @include at(1706, 3971 - $top, 436, 638);

      @include phone {
        display: none;
      }
    }
  }

  .nav {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;

    :global(.arrow) {
      width: 100%;
    }
  }

  .nav-prev {
    @include at(797, 1030, 40, 24);
    transform: scaleX(-1);

    @include phone {
      @include at(170, 296, 24, 16);
    }
  }

  .nav-next {
    @include at(887, 1030, 40, 24);

    @include phone {
      @include at(210, 296, 24, 16);
    }
  }

  .side-l {
    @include at(79, 3971 - $top, 436, 638);

    @include phone {
      @include at(-18, 1555 - $p-top, 127, 184);
    }
  }

  .center {
    @include at(587, 3881.6 - $top, 560, 818);

    @include phone {
      @include at(129, 1530 - $p-top, 163, 235);
    }
  }

  .side-r {
    @include at(1220, 3971 - $top, 436, 638);

    @include phone {
      @include at(312, 1555 - $p-top, 127, 184);
    }
  }
</style>
