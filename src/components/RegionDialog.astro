---
const regions = [
  { label: 'United Arab Emirates', href: 'https://pythal.ae/' },
  { label: 'India', href: 'https://pythal.in/' },
];
---

<dialog class="region" aria-labelledby="region-title" data-region>
  <button class="close" type="button" aria-label="Close" data-region-close>×</button>
  <h2 id="region-title">Choose your Pythal</h2>
  <p>Select where you would like to shop.</p>
  <ul>
    {
      regions.map((r) => (
        <li>
          <a class="pill" href={r.href} target="_blank" rel="noopener">
            {r.label}
          </a>
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-region]');
  document.querySelectorAll('[data-region-open]').forEach((el) =>
    el.addEventListener('click', () => {
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());
      dialog?.showModal();
    }),
  );
  dialog?.querySelector('[data-region-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style lang="scss">
  .region {
    width: min(460px, calc(100vw - 32px));
    padding: 36px 30px 32px;
    border: 1px solid #d7c1ad;
    border-radius: 24px;
    background: #fff;
    text-align: center;
    box-shadow: 0 26px 70px rgb(0 0 0 / 0.12);

    &::backdrop {
      background: rgb(255 255 255 / 0.7);
      backdrop-filter: blur(4px);
    }
  }

  h2 {
    font-family: var(--font-script);
    font-size: 44px;
    line-height: 1.2;
  }

  p {
    margin-top: 8px;
    color: var(--taupe);
    font-size: 15px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    height: 44px;
    padding: 0 22px;
    font-size: 15px;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 16px;
    font-size: 26px;
    line-height: 1;
    color: #6d6d6d;
  }
</style>
