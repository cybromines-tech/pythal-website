---
// Silent looping background film at full 720×1280 resolution. Desktop gets the untouched
// original; phones get a lighter 25fps encode of the same resolution so it starts sooner on
// mobile data. Both have the index at the start so playback begins while downloading.
interface Props {
  name: string;
  label?: string;
  /** Above-the-fold videos start downloading immediately. */
  eager?: boolean;
}
const { name, label, eager = false } = Astro.props;
---

<video
  muted
  loop
  playsinline
  autoplay={eager}
  preload={eager ? 'auto' : 'none'}
  poster={`/images/poster-${name}.webp`}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-autoplay
>
  <source src={`/video/${name}-m.mp4`} type="video/mp4" media="(max-width: 767.98px)" />
  <source src={`/video/${name}.mp4`} type="video/mp4" />
</video>
