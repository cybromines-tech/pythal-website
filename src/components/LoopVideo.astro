---
// Silent looping background film at the original resolution and quality. Files are
// remuxed with the index at the start so playback begins before the download finishes.
interface Props {
  name: string;
  label?: string;
  /** Above-the-fold videos start downloading immediately. */
  eager?: boolean;
}
const { name, label, eager = false } = Astro.props;
---

<video
  muted
  loop
  playsinline
  autoplay={eager}
  preload={eager ? 'auto' : 'none'}
  poster={`/images/poster-${name}.webp`}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-autoplay
>
  <source src={`/video/${name}.mp4`} type="video/mp4" />
</video>
