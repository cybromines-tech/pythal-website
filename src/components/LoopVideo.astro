---
// Silent looping background film. Desktop gets the untouched 720×1280
// original; phones get a 540px 25fps encode (more pixels than a phone displays) so it starts
// sooner on mobile data. Both have the index at the start so playback begins while downloading.
interface Props {
  name: string;
  label?: string;
  /** Above-the-fold videos start downloading immediately. */
  eager?: boolean;
  /** Films whose owner decides when to download and play them, e.g. the fashion carousel. */
  managed?: boolean;
}
const { name, label, eager = false, managed = false } = Astro.props;
---

<video
  muted
  loop
  playsinline
  autoplay={eager}
  preload={eager ? 'auto' : 'none'}
  poster={`/images/poster-${name}.webp`}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-autoplay={managed ? undefined : true}
>
  <source src={`/video/${name}-m.mp4`} type="video/mp4" media="(max-width: 767.98px)" />
  <source src={`/video/${name}.mp4`} type="video/mp4" />
</video>
